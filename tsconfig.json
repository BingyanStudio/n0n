{
	"compilerOptions": {
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"allowJs": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"types": ["bun", "node"],
		"paths": {
			"@n0n/types": ["./packages/types/src/index.ts"],
			"@n0n/shared": ["./packages/shared/src/index.ts"],
			"@n0n/llm": ["./packages/llm/src/index.ts"],
			"@n0n/tools": ["./packages/tools/src/index.ts"],
			"@n0n/core": ["./packages/core/src/index.ts"],
			"@n0n/workflow": ["./packages/workflow/src/index.ts"],
			"@n0n/scheduler": ["./packages/scheduler/src/index.ts"],
			"@n0n/cli-ui": ["./packages/cli-ui/src/index.ts"]
		}
	},
	"include": [
		"packages/*/src/**/*.ts",
		"apps/*/src/**/*.ts",
		"apps/*/src/**/*.d.ts",
		"workflows/**/*.ts",
		"scripts/**/*.ts"
	],
	"exclude": ["node_modules", "dist"]
}
